[Unit]
Description=TaraSec AI assessment
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/taransvar/perl
ExecStart=/usr/bin/flock -n /run/tarasec-ai.lock /usr/bin/perl /root/taransvar/perl/request-AI.pl
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
