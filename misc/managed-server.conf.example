# TaraSec managed-hotspot enrollment server configuration
# Copy to /etc/tarasec-managed-server.conf on the TaraSec BACK-OFFICE enrollment server.
# chmod 600 /etc/tarasec-managed-server.conf

# NetBird control plane. Dedicated service-user token only.
NETBIRD_API_BASE=https://netbird.taransvar.no/api
NETBIRD_MANAGEMENT_URL=https://netbird.taransvar.no
NETBIRD_API_TOKEN=
NETBIRD_HOTSPOT_GROUP_ID=

# Wazuh/SOC API. Dedicated RBAC API user only.
WAZUH_API_BASE=https://soc.example.org:55000
WAZUH_MANAGER=soc.example.org
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_VERIFY_TLS=1
WAZUH_CA_FILE=

# Back-office -> global DB owner-registration forwarding.
# The same long random secret must be configured as SHARED_SECRET in
# /etc/tarasec-global-register.conf on the global DB web/API server.
GLOBAL_DB_REGISTER_URL=https://global.example.org/script/globalManagedRegister.php
GLOBAL_DB_SHARED_SECRET=

# Managed payment offer shown to hotspot owners.
PAYMENT_AVAILABLE=1
PAYMENT_CONTACT_URL=https://tarasec.org/
