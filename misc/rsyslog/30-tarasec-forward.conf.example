# TaraSec gateway/sensor -> DB server security telemetry forwarding.
# Install as /etc/rsyslog.d/30-tarasec-forward.conf and replace DB_SERVER.
#
# TCP/5514 is the only transport. The DB server records the real peer address
# (TARASEC_SENSOR_IP) and remote_syslog_normalizer.pl creates the syslogThreat
# rows. Do not add a UDP/514 copy: UDP senders can be spoofed, taralink's UDP
# parser stores the attacker address as the sender, and a second copy creates
# duplicate threat rows. See docs/REMOTE_THREAT_EVENT_FORMAT.md.

template(name="TaraSecForwardFormat" type="string"
         string="<%pri%>1 %timestamp:::date-rfc3339% %hostname% %programname% - - %msg%\n")

# Reliable copy of selected security telemetry. Disk queue survives DB-server outages.
if ($msg contains "TARASEC_" or
    $programname == "sshd" or
    $programname == "cowrie" or
    $programname == "tarasec-ssh-honeypot") then {
    action(
        type="omfwd"
        target="DB_SERVER"
        port="5514"
        protocol="tcp"
        template="TaraSecForwardFormat"
        action.resumeRetryCount="-1"
        queue.type="LinkedList"
        queue.filename="tarasec_forward"
        queue.spoolDirectory="/var/spool/rsyslog"
        queue.saveOnShutdown="on"
        queue.maxDiskSpace="256m"
    )
}
