# TaraSec server-manager policy
# Installed to /etc/tarasec-server-manager.conf (root:root, mode 0600).
# This is a KEY=value file, not a shell script. Edit the installed copy; rerunning
# the installer preserves it. The worker reads it at each timer run (about once
# per minute), so ordinary value changes need no service restart.
# Full setting reference: misc/AGENT_APPROVALS.md in the taransvar repository.
#
# Current implementation: deterministic checks, a structured assessment, and
# two optional SSH actions, plus advisory assessments through the central
# AI service. Provider keys stay central; no unrestricted command executor is
# connected. Values described as "declared" below do not enforce website login.
#
# Booleans accepted by the worker: yes/no (also 1/0, true/false, on/off).
# Any other or missing value for an action flag behaves as no.
# Integer values outside the documented range are clamped; malformed values
# fall back to the default. Avoid inline comments on value lines.

# The only documented mode today is conservative (default). It is reported in
# assessments, but it does not itself enable/disable an action; the two action
# flags below are the actual controls. Other mode values have no defined effect.
AI_AGENT_MODE=conservative

# Include the latest bounded local agent assessment in crontasks.pl's per-minute
# status report. Set no to send exactly "report disabled" as aiAgent. This only
# changes that report; the worker, its approval heartbeat and local checks run.
AI_STATUS_REPORT_ENABLED=yes

# Set yes ONLY for a genuinely usable local or out-of-band recovery console.
# A live SSH session on the port being protected is not a recovery console.
# Even with yes, containment requires a fresh heartbeat file on this node.
TERMINAL_AVAILABLE=no
# File mtime represents an operator at that console confirming availability.
# A one-time touch expires; never automate the touch from the agent timer.
TERMINAL_HEARTBEAT_FILE=/run/tarasec/operator-terminal.heartbeat
# Freshness limit: 30..3600 seconds; default 120.
TERMINAL_HEARTBEAT_MAX_AGE_SECONDS=120

# With a verified console and threshold-confirmed SSH attack, reject NEW TCP
# connections to SSH_PORT from /etc/tarasecfw.conf for a bounded period.
# This touches INPUT, not FORWARD; the listener and established sessions stay.
# A transient systemd timer rolls back the rule. Default no.
AI_MAY_CLOSE_SSH_DURING_ACTIVE_ATTACK=no

# Separate opt-in: with the SAME guards, SIGTERM sshd processes holding
# established connections on SSH_PORT. This can disconnect a legitimate
# administrator and has no automatic reconnection. Default no.
AI_MAY_TERMINATE_EXISTING_SSH_SESSIONS=no

# Count journal lines matching SSH authentication failures in the last window.
# Window: 60..900 seconds (default 120).
SSH_ATTACK_WINDOW_SECONDS=120
# Minimum matching lines that define "ongoing": 5..10000 (default 20).
# This is a count of journal lines, not a count of distinct attackers.
SSH_ATTACK_FAILURE_THRESHOLD=20
# Duration of NEW connection rejection: 60..3600 seconds (default 600).
# This setting does not limit established-session termination.
SSH_CONTAINMENT_SECONDS=600

# DECLARATIONS / FUTURE WEBSITE CAPABILITIES:
# The current node worker does not read the AUTH_* keys. The website's actual
# operator authentication is configured separately in its private PHP config.
# Changing any value here does not activate passkeys, email, SMS, or change the
# website's approval requirements. Keep these values as intent/documentation.
AUTH_PASSKEY_ENABLED=yes
AUTH_TOTP_ENABLED=yes
AUTH_EMAIL_VERIFICATION_ENABLED=yes
AUTH_SMS_VERIFICATION_ENABLED=no
AUTH_OIDC_ENABLED=yes
AUTH_RECOVERY_CODES_ENABLED=yes
AUTH_DANGEROUS_ACTION_MINIMUM=phishing_resistant_mfa

# Authenticated TaraSec endpoint; provider API keys stay on the central server.
# Set this to the DB server HTTPS endpoint when hosting the central backend there.
NODE_API_URL=https://tarasec.org/ops/agent/api.php
NODE_AUTO_ENROLLMENT=yes
CENTRAL_AI_ENABLED=yes
