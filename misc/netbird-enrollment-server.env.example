# TaraSec server-side NetBird enrollment configuration
#
# Install this on the TaraSec enrollment web server as:
#   /etc/tarasec/netbird-enrollment.env
# chmod it so only root/the web service can read it as appropriate.
# NEVER commit the real NB_API_TOKEN.

# Base URL of the NetBird REST API for the TaraSec management installation.
# For NetBird Cloud this is https://api.netbird.io
# For self-hosted NetBird use the API base exposed by that installation.
NB_API_URL=https://api.netbird.io

# NetBird personal access token/service-user token with permission to create
# setup keys. Store the real token only on the TaraSec enrollment server.
NB_API_TOKEN=REPLACE_ON_SERVER

# NetBird group ID for newly bootstrapped TaraSec hotspots. This group must be
# isolated by policy: no lateral hotspot-to-hotspot access and only the minimum
# SOC/management reachability needed for registration and health checks.
NB_BOOTSTRAP_GROUP_ID=REPLACE_WITH_GROUP_ID

# Management URL passed to `netbird up` on self-hosted installations.
# Leave blank when the default NetBird management endpoint is correct.
NB_MANAGEMENT_URL=
