#!/bin/bash
set -euo pipefail

CONFIG=/etc/tarasec/access.env
MAC="${1:-}"
IP="${2:-}"

[[ "$MAC" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || { echo deny; exit 1; }
[[ "$IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { echo deny; exit 1; }
[ -r "$CONFIG" ] || { echo deny; exit 1; }
# shellcheck disable=SC1090
. "$CONFIG"

RESPONSE="$(curl -sS --connect-timeout 4 --max-time 10 \
    -H "X-TaraSec-Gateway-Key: $TARASEC_GATEWAY_KEY" \
    -H "X-TaraSec-Token: $TARASEC_GATEWAY_TOKEN" \
    --data-urlencode "device_key=${MAC,,}" \
    --data-urlencode "client_ip=$IP" \
    "${TARASEC_ACCESS_URL:-https://tarasec.org/api/v1/subscriber/access-api.php}" 2>/dev/null || true)"

if printf '%s' "$RESPONSE" | grep -Eq '"(auth|hasaccess|allow|allowed)"[[:space:]]*:[[:space:]]*(true|1)|"status"[[:space:]]*:[[:space:]]*"auth"'; then
    echo auth
    exit 0
fi

if printf '%s' "$RESPONSE" | grep -Eq '"ok"[[:space:]]*:[[:space:]]*true' &&
   printf '%s' "$RESPONSE" | grep -Eq '"(bound|active|authorized)"[[:space:]]*:[[:space:]]*true'; then
    echo auth
    exit 0
fi

echo deny
exit 1
