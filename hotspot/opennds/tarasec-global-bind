#!/bin/bash
set -euo pipefail
CONFIG=/etc/tarasec/access.env
HOTSPOT_CONFIG=/etc/tarasec/hotspot-dns.conf
CODE="${1:-}"
CLIENT_IP="${2:-}"
[[ "$CODE" =~ ^[A-Za-z0-9_-]{40,64}$ ]] || { echo '{"ok":false,"reason":"invalid_code"}'; exit 1; }
[[ "$CLIENT_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { echo '{"ok":false,"reason":"invalid_client_ip"}'; exit 1; }
[ -r "$CONFIG" ] && [ -r "$HOTSPOT_CONFIG" ] || { echo '{"ok":false,"reason":"gateway_not_configured"}'; exit 1; }
# shellcheck disable=SC1090
. "$CONFIG"
# shellcheck disable=SC1090
. "$HOTSPOT_CONFIG"
MAC="$(ip neigh show to "$CLIENT_IP" dev "$HOTSPOT_IF" 2>/dev/null | awk '/lladdr/ {for(i=1;i<=NF;i++) if($i=="lladdr"){print tolower($(i+1));exit}}')"
[[ "$MAC" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] || { echo '{"ok":false,"reason":"client_mac_not_observed"}'; exit 1; }
RESPONSE=""
if ! RESPONSE="$(curl -sS --connect-timeout 4 --max-time 10 \
    -H "X-TaraSec-Gateway-Key: $TARASEC_GATEWAY_KEY" \
    -H "X-TaraSec-Token: $TARASEC_GATEWAY_TOKEN" \
    --data-urlencode "code=$CODE" \
    --data-urlencode "device_key=$MAC" \
    "${TARASEC_BIND_URL:-https://tarasec.org/api/v1/subscriber/device-bind.php}")"; then
    logger -t tarasec-global-bind "central request failed for client $CLIENT_IP mac $MAC"
    echo '{"ok":false,"reason":"central_service_unavailable"}'
    exit 1
fi
logger -t tarasec-global-bind "client=$CLIENT_IP mac=$MAC response=$RESPONSE"

# Binding the global identity and authenticating the captive-portal client are
# separate operations. Complete the local handoff here so app users do not
# have to reopen the portal and press "Continue to Internet".
if printf '%s' "$RESPONSE" | grep -Eq '"ok"[[:space:]]*:[[:space:]]*true' &&
   printf '%s' "$RESPONSE" | grep -Eq '"bound"[[:space:]]*:[[:space:]]*true'; then
    # Persist a local, privacy-minimal marker that this device was authenticated
    # through TaraSec's global subscriber service. The accounting worker uses
    # this to separate roaming/external traffic from locally-created users.
    CUSTOMER_ID="$(printf '%s' "$RESPONSE" | perl -MJSON::PP -0777 -ne '
        eval { my $j=decode_json($_); my $v=$j->{customer_id}//$j->{customerId}//""; print $v if $v =~ /^[A-Za-z0-9_.:@-]{1,128}$/; };
    ' 2>/dev/null || true)"
    if command -v mysql >/dev/null 2>&1; then
        if [ -n "$CUSTOMER_ID" ]; then
            mysql taransvar -e "INSERT INTO hotspotRoamingBinding(deviceKey,customerId,source,boundTime,lastSeen) VALUES('$MAC','$CUSTOMER_ID','global',NOW(),NOW()) ON DUPLICATE KEY UPDATE customerId=VALUES(customerId),source='global',lastSeen=NOW();" >/dev/null 2>&1 || \
                logger -t tarasec-global-bind "unable to record roaming binding for mac $MAC"
        else
            mysql taransvar -e "INSERT INTO hotspotRoamingBinding(deviceKey,customerId,source,boundTime,lastSeen) VALUES('$MAC',NULL,'global',NOW(),NOW()) ON DUPLICATE KEY UPDATE source='global',lastSeen=NOW();" >/dev/null 2>&1 || \
                logger -t tarasec-global-bind "unable to record roaming binding for mac $MAC"
        fi
    fi

    /usr/local/sbin/tarasec-access-refresh >/dev/null 2>&1 || true
    if command -v ndsctl >/dev/null 2>&1; then
        authenticated=0
        for _ in $(seq 1 5); do
            ndsctl auth "$CLIENT_IP" >/dev/null 2>&1 || true
            state="$(ndsctl json "$CLIENT_IP" 2>/dev/null || true)"
            if printf '%s' "$state" | grep -Eq '"state"[[:space:]]*:[[:space:]]*"Authenticated"'; then
                authenticated=1
                break
            fi
            sleep 1
        done
        if [ "$authenticated" -eq 1 ]; then
            logger -t tarasec-global-bind "opennds authenticated client=$CLIENT_IP mac=$MAC"
        else
            logger -t tarasec-global-bind "opennds authentication pending client=$CLIENT_IP mac=$MAC"
        fi
    fi
fi

printf '%s\n' "$RESPONSE"
