#!/usr/bin/env perl
use strict;
use warnings;
use DBI;
use JSON::PP qw(decode_json);
use IPC::Open3;
use Symbol qw(gensym);

my $json = qx{ndsctl json 2>/dev/null};
exit 0 if $? != 0 || $json eq '';
my $data = eval { decode_json($json) };
exit 0 if !$data || ref($data->{clients}) ne 'HASH';

my $dbh = DBI->connect(
    'DBI:mysql:database=taransvar;host=localhost', 'root', '',
    { RaiseError => 1, PrintError => 0, AutoCommit => 1 }
) or die "Unable to connect to TaraSec database\n";

my %access_env = read_env('/etc/tarasec/access.env');
my $gateway_key = $access_env{TARASEC_GATEWAY_KEY} // '';
my $gateway_token = $access_env{TARASEC_GATEWAY_TOKEN} // '';
my $access_url = $access_env{TARASEC_ACCESS_URL} // 'https://tarasec.org/api/v1/subscriber/access-api.php';
my $accounting_url = $access_env{TARASEC_ACCOUNTING_URL} // 'https://tarasec.org/api/v1/subscriber/accounting-api.php';
my $central_ready = ($gateway_key ne '' && $gateway_token ne '');

my $find = $dbh->prepare(q{
    SELECT s.sessionid,s.username,h.subscriptionType,h.quotaMB,h.usageMB
      FROM session s
      JOIN hotspotSubscriber h ON h.username=s.username
     WHERE s.ip=? AND s.active=1
     ORDER BY s.sessionid DESC LIMIT 1
});
my $checkpoint = $dbh->prepare(
    'SELECT uploadKiB,downloadKiB FROM hotspotUsageCheckpoint WHERE sessionId=? FOR UPDATE'
);
my $insert = $dbh->prepare(q{
    INSERT INTO hotspotUsageCheckpoint(sessionId,uploadKiB,downloadKiB,updated)
    VALUES(?,?,?,NOW())
    ON DUPLICATE KEY UPDATE uploadKiB=VALUES(uploadKiB),downloadKiB=VALUES(downloadKiB),updated=NOW()
});
my $add = $dbh->prepare(q{
    UPDATE hotspotSubscriber SET usageMB=usageMB+(?/1024.0) WHERE username=?
});
my $history = $dbh->prepare(q{
    INSERT INTO userusage(user,ip,yyyymmddhh,mb)
    VALUES(?,?,DATE_FORMAT(NOW(),'%Y-%m-%d %H:%i'),?/1024.0)
    ON DUPLICATE KEY UPDATE mb=COALESCE(mb,0)+VALUES(mb)
});
my $touch = $dbh->prepare('UPDATE session SET lastrequest=NOW() WHERE sessionid=?');
my $remaining = $dbh->prepare(
    'SELECT subscriptionType,quotaMB,usageMB FROM hotspotSubscriber WHERE username=?'
);
my $roaming = $dbh->prepare(
    'SELECT 1,customerId FROM hotspotRoamingBinding WHERE deviceKey=? LIMIT 1'
);
my $earning_config = $dbh->prepare(q{
    SELECT roamingPriceKshPerMiB,networkFeePercent,currency,CAST(isDemo AS UNSIGNED)
      FROM hotspotEarningConfig WHERE configId=1
});
my $earning = $dbh->prepare(q{
    INSERT INTO hotspotEarning(
        sessionId,customerId,deviceKey,usageMiB,grossAmount,networkFee,netAmount,currency,settlementStatus,isDemo
    ) VALUES(?,?,?,?,?,?,?,?, 'pending', ?)
});

for my $client_key (keys %{$data->{clients}}) {
    my $client = $data->{clients}{$client_key};
    next if ref($client) ne 'HASH' || ($client->{state} // '') ne 'Authenticated';
    my $ip = $client->{ip} // '';
    next if $ip !~ /\A(?:\d{1,3}\.){3}\d{1,3}\z/;
    my $up = int($client->{upload_this_session} // 0);
    my $down = int($client->{download_this_session} // 0);
    next if $up < 0 || $down < 0;
    my $device_key = lc($client->{mac} // $client_key // '');
    $device_key = '' unless $device_key =~ /\A(?:[0-9a-f]{2}:){5}[0-9a-f]{2}\z/;

    # Global TaraSec subscribers are accounted centrally. openNDS reports
    # cumulative KiB counters; the central accounting API accepts cumulative
    # bytes and computes/charges only the increase since the previous report.
    if ($central_ready && $device_key ne '') {
        eval {
            $roaming->execute($device_key);
            my ($is_roaming) = $roaming->fetchrow_array;
            if ($is_roaming) {
                my $access_body = curl_form(
                    $access_url,
                    $gateway_key,
                    $gateway_token,
                    [ device_key => $device_key, client_ip => $ip ]
                );
                my $access = eval { decode_json($access_body) };
                if ($access && $access->{ok} && $access->{allow} && int($access->{session_id} // 0) > 0) {
                    my $session_id = int($access->{session_id});
                    my $account_body = curl_form(
                        $accounting_url,
                        $gateway_key,
                        $gateway_token,
                        [
                            session_id => $session_id,
                            bytes_up => $up * 1024,
                            bytes_down => $down * 1024,
                        ]
                    );
                    my $account = eval { decode_json($account_body) };

                    # A reconnect resets openNDS counters. The central API closes
                    # the previous session instead of treating the reset as new
                    # usage. Request a fresh session and retry in this same poll
                    # so the app does not keep showing the old connection total.
                    if ($account && !$account->{ok}
                        && ($account->{reason} // '') eq 'session_reset_required') {
                        my $retry_access_body = curl_form(
                            $access_url,
                            $gateway_key,
                            $gateway_token,
                            [ device_key => $device_key, client_ip => $ip ]
                        );
                        my $retry_access = eval { decode_json($retry_access_body) };
                        if ($retry_access && $retry_access->{ok} && $retry_access->{allow}
                            && int($retry_access->{session_id} // 0) > 0) {
                            $session_id = int($retry_access->{session_id});
                            $account_body = curl_form(
                                $accounting_url,
                                $gateway_key,
                                $gateway_token,
                                [
                                    session_id => $session_id,
                                    bytes_up => $up * 1024,
                                    bytes_down => $down * 1024,
                                ]
                            );
                            $account = eval { decode_json($account_body) };
                            logger("central counter reset recovered with session=$session_id client=$ip");
                        }
                    }

                    if ($account && $account->{ok}) {
                        logger("central session=$session_id client=$ip usage_mib=".($account->{usage_mib}//'0')." charged=".($account->{charged_credits}//'0'));
                        if (exists $account->{allow} && !$account->{allow}) {
                            system('ndsctl','deauth',$ip);
                            logger("central credit exhausted for $device_key at $ip");
                        }
                    } else {
                        logger("central accounting rejected client=$ip response=$account_body");
                    }
                } elsif ($access && $access->{ok} && !$access->{allow}) {
                    system('ndsctl','deauth',$ip);
                    logger("central access denied for $device_key at $ip reason=".($access->{reason}//'unknown'));
                } else {
                    logger("central access lookup failed client=$ip response=$access_body");
                }
            }
        };
        logger("central accounting failed for $ip: $@") if $@;
    }

    # Preserve legacy local-subscriber accounting for hotspot-local accounts.
    eval {
        $dbh->begin_work;
        $find->execute($ip);
        my ($session_id,$username) = $find->fetchrow_array;
        if (!$session_id || !defined $username) {
            $dbh->rollback;
            next;
        }

        $checkpoint->execute($session_id);
        my ($old_up,$old_down) = $checkpoint->fetchrow_array;
        $old_up = 0 unless defined $old_up;
        $old_down = 0 unless defined $old_down;

        my $delta_up = $up >= $old_up ? $up - $old_up : $up;
        my $delta_down = $down >= $old_down ? $down - $old_down : $down;
        my $delta_kib = $delta_up + $delta_down;

        if ($delta_kib > 0) {
            $add->execute($delta_kib,$username);
            $history->execute($username,$ip,$delta_kib);

            if ($device_key ne '') {
                $roaming->execute($device_key);
                my ($is_roaming,$customer_id) = $roaming->fetchrow_array;
                if ($is_roaming) {
                    $earning_config->execute();
                    my ($rate,$fee_percent,$currency,$is_demo) = $earning_config->fetchrow_array;
                    if (defined $rate && $rate >= 0) {
                        my $usage_mib = $delta_kib / 1024.0;
                        my $gross = $usage_mib * $rate;
                        my $fee = $gross * (($fee_percent // 0) / 100.0);
                        my $net = $gross - $fee;
                        $earning->execute(
                            $session_id,$customer_id,$device_key,$usage_mib,$gross,$fee,$net,
                            ($currency // 'KES'),($is_demo ? 1 : 0)
                        );
                    }
                }
            }
        }
        $insert->execute($session_id,$up,$down);
        $touch->execute($session_id);
        $remaining->execute($username);
        my ($type,$quota,$usage) = $remaining->fetchrow_array;
        $dbh->commit;

        if (($type // '') eq 'quota' && ($quota // 0) > 0 && ($usage // 0) >= $quota) {
            system('/usr/local/sbin/tarasec-subscriber-logout',$ip);
            logger("quota exhausted for $username at $ip");
        }
    };
    if ($@) {
        eval { $dbh->rollback };
        logger("accounting failed for $ip: $@");
    }
}
$dbh->disconnect;

sub read_env {
    my ($path) = @_;
    my %values;
    return %values if !-r $path;
    open my $fh, '<', $path or return %values;
    while (my $line = <$fh>) {
        chomp $line;
        $line =~ s/^\s+|\s+$//g;
        next if $line eq '' || $line =~ /^#/;
        next unless $line =~ /^([A-Za-z_][A-Za-z0-9_]*)=(.*)$/;
        my ($key,$value)=($1,$2);
        $value =~ s/^['\"]//;
        $value =~ s/['\"]$//;
        $values{$key}=$value;
    }
    close $fh;
    return %values;
}

sub curl_form {
    my ($url,$key,$token,$pairs) = @_;
    my @cmd = (
        'curl','-sS','--connect-timeout','4','--max-time','10',
        '-H',"X-TaraSec-Gateway-Key: $key",
        '-H',"X-TaraSec-Token: $token",
    );
    while (@$pairs) {
        my $name = shift @$pairs;
        my $value = shift @$pairs;
        push @cmd, '--data-urlencode', "$name=$value";
    }
    push @cmd, $url;
    my $err = gensym;
    my $pid = open3(undef, my $out, $err, @cmd);
    local $/;
    my $stdout = <$out> // '';
    my $stderr = <$err> // '';
    waitpid($pid,0);
    die "curl failed: $stderr" if $? != 0;
    return $stdout;
}

sub logger {
    my ($message)=@_;
    system('logger','-t','tarasec-hotspot-accounting',$message);
}
