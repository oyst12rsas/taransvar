#!/usr/bin/env bash
set -euo pipefail
IP="${1:-}"
MYSQL_CNF="${TARASEC_ACCESS_MYSQL_CNF:-/etc/tarasec/access-mysql.cnf}"
MYSQL=(mysql)
[ -r "$MYSQL_CNF" ] && MYSQL+=(--defaults-extra-file="$MYSQL_CNF")
MYSQL+=(--batch --skip-column-names --raw taransvar)

if [[ ! "$IP" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    logger -t tarasec-logout "ignored invalid client ip: $IP"
    exit 2
fi
for octet in "${BASH_REMATCH[@]:1}"; do
    (( octet >= 0 && octet <= 255 )) || exit 2
done

GW=$("${MYSQL[@]}" -e "SELECT INET_NTOA(internalIP) FROM setup LIMIT 1" 2>/dev/null | tr -d '[:space:]')
[ -n "$GW" ] || GW="192.168.50.1"
IFS=. read -r g1 g2 g3 g4 <<<"$GW"
IFS=. read -r i1 i2 i3 i4 <<<"$IP"
if [ "$g1.$g2.$g3" != "$i1.$i2.$i3" ]; then
    logger -t tarasec-logout "ignored non-hotspot client ip: $IP (gateway $GW)"
    exit 2
fi

"${MYSQL[@]}" <<SQL
UPDATE session
SET active=0,
    logouttime=COALESCE(logouttime,NOW()),
    lastrequest=NOW()
WHERE ip='$IP' AND active=1;
DELETE FROM access WHERE ip='$IP';
SQL

MAC="$(ip neigh show "$IP" 2>/dev/null | awk '/lladdr/{print $5; exit}')"
if [[ "$MAC" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]; then
    ndsctl deauth "$MAC" >/dev/null 2>&1 || true
fi
logger -t tarasec-logout "subscriber logout closed TaraSec session/access for $IP${MAC:+/$MAC}"
