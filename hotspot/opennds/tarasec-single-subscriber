#!/usr/bin/env perl
use strict;
use warnings;
use DBI;

my $dbh = eval {
    DBI->connect(
        'DBI:mysql:database=taransvar;host=localhost',
        undef,
        undef,
        {
            RaiseError => 1,
            PrintError => 0,
            AutoCommit => 1,
            mysql_enable_utf8mb4 => 1,
            mysql_read_default_file => '/etc/tarasec/access-mysql.cnf',
        }
    )
};
exit 0 unless $dbh;

# This helper is intentionally only a setup-state detector.  Older versions
# printed the sole subscriber's clear-text username/password into the captive
# portal as a testing convenience.  Captive clients must never be given local
# account credentials automatically.
my $sth = eval {
    my $s = $dbh->prepare(q{
        SELECT hs.username,
               COALESCE(MAX(CAST(u.isAdmin AS UNSIGNED)),0) AS is_admin
          FROM hotspotSubscriber hs
          LEFT JOIN user u ON u.username=hs.username
         WHERE CAST(hs.enabled AS UNSIGNED)=1
         GROUP BY hs.subscriberId,hs.username
         ORDER BY hs.subscriberId
         LIMIT 2
    });
    $s->execute;
    $s;
};
exit 0 unless $sth;

my @rows;
while (my $row = $sth->fetchrow_hashref) {
    push @rows, $row;
}
$dbh->disconnect;

# A single enabled non-admin subscriber is the state produced by the optional
# installer test account.  Return only a boolean marker so the portal can show
# operator guidance without disclosing either username or password.
exit 0 unless @rows == 1;
exit 0 if $rows[0]{is_admin};
print "1\n";
